<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Sovereign.Desktop</RootNamespace>
    <AssemblyName>SIDesk</AssemblyName>
    <ApplicationTitle>SI Desk</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\xAIDesk.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="$(PrivateDesktopCompileRemove)" Condition="'$(PrivateDesktopCompileRemove)' != ''" />
    <Content Include="..\phone\www\**\*" Link="phone\www\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\.cursor\skills\**\*" Link=".cursor\skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\xAIDesk.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="skill-chroma\embed384.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\SubagentAvatars\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\scripts\Install-CursorConnection.ps1" Link="setup\Install-CursorConnection.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- cloudflared.exe is downloaded by scripts/Get-Cloudflared.ps1 and is gitignored. -->
    <Content Include="..\room-tunnel\*" Link="room-tunnel\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\phone\Sovereign.Desktop.Phone.csproj" />
    <ProjectReference Include="..\connector\Sovereign.Desktop.Connector.csproj" />
    <ProjectReference Include="..\swarm-manager\Sovereign.Desktop.SwarmManager.csproj" />
    <ProjectReference Include="..\Sovereign.Desktop.Updates\Sovereign.Desktop.Updates.csproj" />
    <ProjectReference Include="..\Sovereign.Desktop.Core\Sovereign.Desktop.Core.csproj" />
    <ProjectReference Include="..\Sovereign.Desktop.Client\Sovereign.Desktop.Client.csproj" />
    <ProjectReference Include="..\Sovereign.Desktop.Presentation\Sovereign.Desktop.Presentation.csproj" />
  </ItemGroup>
  <Target Name="CopySwarmManagerExe" AfterTargets="Build">
    <PropertyGroup>
      <_SwarmManagerDir>$(MSBuildThisFileDirectory)..\swarm-manager\bin\$(Configuration)\net10.0\</_SwarmManagerDir>
    </PropertyGroup>
    <ItemGroup>
      <_SwarmManagerExe Include="$(_SwarmManagerDir)Sovereign.Desktop.SwarmManager.exe" Condition="Exists('$(_SwarmManagerDir)Sovereign.Desktop.SwarmManager.exe')" />
      <_SwarmManagerExe Include="$(_SwarmManagerDir)Sovereign.Desktop.SwarmManager" Condition="Exists('$(_SwarmManagerDir)Sovereign.Desktop.SwarmManager')" />
      <_SwarmManagerExe Include="$(_SwarmManagerDir)Sovereign.Desktop.SwarmManager.dll" Condition="Exists('$(_SwarmManagerDir)Sovereign.Desktop.SwarmManager.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_SwarmManagerExe)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_SwarmManagerExe)' != ''" />
  </Target>
  <UsingTask TaskName="ResolveWindowsDesktopAutomationTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <NetCoreRoot ParameterType="System.String" />
      <WindowsDesktopAutomationDir ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        WindowsDesktopAutomationDir = string.Empty;
        if (!string.IsNullOrWhiteSpace(NetCoreRoot))
        {
          string packRoot = Path.Combine(NetCoreRoot, "shared", "Microsoft.WindowsDesktop.App");
          if (Directory.Exists(packRoot))
          {
            Version bestVersion = new Version(0, 0);
            string bestDirectory = string.Empty;
            bool found = false;
            foreach (string directory in Directory.GetDirectories(packRoot))
            {
              Version parsed;
              if (!Version.TryParse(Path.GetFileName(directory), out parsed))
              {
                continue;
              }

              if (!File.Exists(Path.Combine(directory, "UIAutomationClient.dll")) ||
                  !File.Exists(Path.Combine(directory, "UIAutomationTypes.dll")))
              {
                continue;
              }

              if (!found || parsed > bestVersion)
              {
                found = true;
                bestVersion = parsed;
                bestDirectory = directory;
              }
            }

            if (found)
            {
              WindowsDesktopAutomationDir = bestDirectory;
            }
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ResolveWindowsDesktopAutomation" BeforeTargets="ResolveAssemblyReferences">
    <ResolveWindowsDesktopAutomationTask NetCoreRoot="$(NetCoreRoot)">
      <Output TaskParameter="WindowsDesktopAutomationDir" PropertyName="WindowsDesktopAutomationDir" />
    </ResolveWindowsDesktopAutomationTask>
    <ItemGroup Condition="'$(WindowsDesktopAutomationDir)' != ''">
      <Reference Include="UIAutomationClient">
        <HintPath>$(WindowsDesktopAutomationDir)\UIAutomationClient.dll</HintPath>
        <Private>true</Private>
      </Reference>
      <Reference Include="UIAutomationTypes">
        <HintPath>$(WindowsDesktopAutomationDir)\UIAutomationTypes.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
    <Message Importance="high" Text="WindowsDesktopAutomationDir=$(WindowsDesktopAutomationDir)" />
  </Target>
  <ItemGroup>
    <Content Include="..\..\..\fixtures\desktop\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\contracts\observed\engine-bundle-pin.json" Link="engine-bundle-pin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\contracts\observed\engine-bundle-pin.json')" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup Condition="'$(DeskRuntimeInventory)' != ''">
    <EmbeddedResource Include="$(DeskRuntimeInventory)" LogicalName="Sovereign.DeskRuntimeInventory" />
  </ItemGroup>
  <ItemGroup Condition="'$(DocumentExtractionInventory)' != ''">
    <EmbeddedResource Include="$(DocumentExtractionInventory)" LogicalName="Sovereign.DocumentExtractionInventory" />
  </ItemGroup>
  <!-- A custom OutputPath skips the WinUI copy of App.xbf. Without that file the
       control theme never loads and the first layout dies on TabViewScrollButtonBackground.
       publish-release.ps1 uses dotnet publish -o, so also copy into PublishDir after Publish. -->
  <Target Name="CopyAppXamlBinary" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)App.xbf" DestinationFiles="$(OutDir)App.xbf" SkipUnchangedFiles="true" Condition="Exists('$(IntermediateOutputPath)App.xbf')" />
    <Copy SourceFiles="Assets\xAIDesk.ico" DestinationFiles="$(OutDir)Assets\xAIDesk.ico" SkipUnchangedFiles="true" Condition="Exists('Assets\xAIDesk.ico')" />
  </Target>
  <Target Name="CopyAppXamlBinaryToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(IntermediateOutputPath)App.xbf" DestinationFiles="$(PublishDir)App.xbf" SkipUnchangedFiles="true" Condition="Exists('$(IntermediateOutputPath)App.xbf') and '$(PublishDir)' != ''" />
  </Target>
  <Import Project="RoomTunnel.targets" />
</Project>
